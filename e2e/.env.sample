# Local-only E2E settings. Copy this file to e2e/.env.local (gitignored) to apply.
# Loaded by e2e/playwright.config.ts when present; absent for other contributors and CI.

# Park the Playwright window off-screen so test runs don't flash, take a taskbar slot,
# or steal focus (headless-style, same speed as a headed run). Unset/0 = normal headed.
E2E_HIDE_WINDOW=1
